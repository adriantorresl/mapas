              <sld:ColorMapEntry color="#8eab03" label="0.4585" quantity="0.45850375585807174"/>
              <sld:ColorMapEntry color="#aec102" label="0.5731" quantity="0.57312840528238829"/>
              <sld:ColorMapEntry color="#ced601" label="0.6878" quantity="0.68775477409364005"/>
              <sld:ColorMapEntry color="#efec00" label="0.8024" quantity="0.80238114290489171"/>
              <sld:ColorMapEntry color="#fbe700" label="0.9170" quantity="0.9170057923292082"/>
              <sld:ColorMapEntry color="#f3c600" label="1.0316" quantity="1.03163216114046"/>
              <sld:ColorMapEntry color="#eba500" label="1.1463" quantity="1.1462585299517118"/>
